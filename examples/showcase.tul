// ==========================================
//   TUL-X Feature Showcase Demo
// ==========================================

print "=== 1. Basic Literals & Print Statements ===";
print "Hello, TUL-X World!";
print 42.5;
print true;
print false;
print null;

print "";
print "=== 2. Arithmetic & Precedence ===";
var a = 10;
var b = 20;
var c = 5;
print "a = 10, b = 20, c = 5";
print "a + b * c = " + (a + b * c);
print "(a + b) * c = " + ((a + b) * c);
print "100 / 4 - 5 = " + (100 / 4 - 5);

print "";
print "=== 3. Dynamic Types & String Concatenation ===";
var language = "TUL-X";
var version = 0.5;
print "Language: " + language + " (version: " + version + ")";
print "Boolean concatenation: " + true + " and " + false;

print "";
print "=== 4. Comparisons & Equality ===";
print "10 > 5: " + (10 > 5);
print "10 <= 5: " + (10 <= 5);
print "10 == 10: " + (10 == 10);
print "'apple' == 'apple': " + ("apple" == "apple");
print "'apple' != 'banana': " + ("apple" != "banana");

print "";
print "=== 5. Variable Mutation & Re-assignment ===";
var score = 50;
print "Initial score: " + score;
score = score + 25;
print "After bonus (+25): " + score;
score = score * 2;
print "After multiplier (*2): " + score;

print "";
print "=== 6. Lexical Scoping & Variable Shadowing ===";
var scopeVar = "global";
print "Outer scope: " + scopeVar;
{
    var scopeVar = "inner block 1";
    var innerOnly = "visible inside block 1";
    print "Inside block 1: " + scopeVar;
    print "Inside block 1: " + innerOnly;

    {
        var scopeVar = "innermost block 2";
        print "Inside block 2: " + scopeVar;
    }

    print "Back in block 1: " + scopeVar;
}
print "Back in global scope: " + scopeVar;

print "";
print "=== 7. Logical Operators & Short-Circuiting ===";
print "true or false: " + (true or false);
print "false and true: " + (false and true);
var defaultName = null or "Tul-X User";
print "Default fallback: " + defaultName;

print "";
print "=== 8. Conditional Branching (if / else) ===";
var temperature = 28;
if (temperature > 30) {
    print "Weather: Hot";
} else {
    if (temperature >= 20) {
        print "Weather: Pleasant (between 20 and 30)";
    } else {
        print "Weather: Cold";
    }
}

print "";
print "=== 9. Loops (while & for) ===";
print "-- While Loop (Countdown) --";
var countdown = 3;
while (countdown > 0) {
    print "T-minus: " + countdown;
    countdown = countdown - 1;
}
print "Liftoff!";

print "-- For Loop (Fibonacci Series) --";
var fib1 = 0;
var fib2 = 1;
for (var i = 0; i < 7; i = i + 1) {
    print "Fibonacci(" + i + ") = " + fib1;
    var next = fib1 + fib2;
    fib1 = fib2;
    fib2 = next;
}

print "";
print "==========================================";
print "  All TUL-X Features Executed Successfully!";
print "==========================================";
